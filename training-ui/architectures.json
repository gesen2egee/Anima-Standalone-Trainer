          "krea2_dynamic_text_encoder_cpu": false,
          "krea2_text_encoder_layer_offload": true,
          "krea2_text_encoder_offload_percent": 1.0,
          "timestep_sampling": "autoshift",
          "discrete_flow_shift": 2.5,
          "sigmoid_scale": 1.0,
          "krea2_max_token_length": 512
        }
      },
      "dataset_defaults": {
        "min_bucket_reso": 256,
