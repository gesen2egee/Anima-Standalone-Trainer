{
  "architectures": {
    "anima": {
      "display_name": "Anima",
      "network_modules": ["networks.lora_anima", "networks.loha", "networks.lokr", "networks.cdka", "networks.krona"],
      "scripts": {
        "train": "anima_train.py",
        "train_network": "anima_train_network.py",
        "generate": "anima_gen.py"
      },
      "global_paths": {
        "dit_path": {
          "label": "DiT Model Path",
          "placeholder": "C:\\Anima\\split_files\\diffusion_models\\anima-preview.safetensors",
          "cli_flag": "pretrained_model_name_or_path",
          "gen_flag": "dit"
        },
        "qwen3_path": {
          "label": "Qwen3 Text Encoder Path",
          "placeholder": "C:\\Anima\\split_files\\text_encoders\\qwen_3_06b_base.safetensors",
          "cli_flag": "qwen3",
          "gen_flag": "text_encoder"
        },
        "vae_path": {
          "label": "VAE Path",
          "placeholder": "C:\\Anima\\split_files\\vae\\qwen_image_vae.safetensors",
          "cli_flag": "vae",
          "gen_flag": "vae"
        }
      },
      "gen_params": {
        "flow_shift": {
          "label": "Flow Shift",
          "type": "number",
          "default": 3.0,
          "step": 0.5,
          "cli_flag": "flow_shift"
        }
      },
      "training_section": "anima_arguments",
      "job_defaults": {
        "training_arguments": {
          "mixed_precision": "bf16",
          "save_precision": "bf16",
          "full_bf16": true,
          "blocks_to_swap": 0,
          "cache_latents": true,
          "cache_latents_to_disk": true,
          "cache_text_encoder_outputs_to_disk": false
        },
        "network_arguments": {
          "network_module": "networks.cdka",
          "network_train_unet_only": true,
          "network_args": [
            "exclude_patterns=[\".*\"]",
            "network_reg_lrs=.*self_attn.*=5e-5",
            "include_patterns=[\".*(self_attn|cross_attn)\\\\.(v_proj|output_proj)\"]",
            "allora=True"
          ]
        },
        "anima_arguments": {
          "timestep_sampling": "autoshift",
          "discrete_flow_shift": 1.0
        }
      },
      "dataset_defaults": {
        "min_bucket_reso": 384,
        "max_bucket_reso": 1536,
        "resolution": 768,
        "fad_timestep": true
      },
      "all_in_one": false,
      "fsdp_transformer_cls": "Block"
    },
    "krea2": {
      "display_name": "Krea 2",
